{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyOutsideLondon",
            "Effect": "Deny",
            "NotAction": [
                "account:*",
                "acm:*",
                "aws-portal:*",
                "billing:*",
                "budgets:*",
                "ce:*",
                "cloudfront:*",
                "cost-optimization-hub:*",
                "cur:*",
                "ec2:DescribeRegions",
                "freetier:*",
                "globalaccelerator:*",
                "health:*",
                "iam:*",
                "identitystore:*",
                "invoicing:*",
                "notifications:*",
                "organizations:*",
                "payments:*",
                "pricing:*",
                "route53:*",
                "route53domains:*",
                "s3:GetAccountPublic*",
                "s3:ListAllMyBuckets",
                "s3:PutAccountPublic*",
                "shield:*",
                "sso:*",
                "sso-directory:*",
                "sts:*",
                "support:*",
                "tax:*",
                "trustedadvisor:*",
                "waf:*",
                "wafv2:*"
            ],
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "aws:RequestedRegion": [
                        "eu-west-2"
                    ]
                }
            }
        }
    ]
}
